# Copy to .env. Sample mode stays on localhost and uses fictional data.
WORKSPACE_MODE=sample
AGENT_BACKEND=sample
PORT=8787
HOST=127.0.0.1
PUBLIC_API_URL=http://localhost:8787
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
DATA_DIR=.openmuse
# Web UI: directory with the Expo web export (`pnpm build:web`). When it
# holds an index.html the API server serves the app UI from the same origin
# (single-service deploys). Default: apps/mobile/dist/web. In that setup the
# web app calls the API on its own origin — EXPO_PUBLIC_API_URL is not
# needed for the hosted web build.
# WEB_DIR=apps/mobile/dist/web
TASK_WORKER_ENABLED=true

# Slack bridge: the agent's own bot user in the owner's Slack workspace.
# Create the app from the manifest in ~/workspace/lab/open-arthur-slack/
# (api.slack.com → Create New App → From a manifest), install it to the
# workspace, then copy these two values from the app settings:
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=...

# General delegated work: select AGENT_BACKEND=model and a provider/model.
# MODEL=openai/your-model-id
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
#
# Gemini Flash (first free-model test, branch exp/gemini-flash-test):
# MODEL=google/gemini-2.5-flash
# GOOGLE_API_KEY=  # AI Studio key; server-only env/secret, NEVER commit a real key.
# The model id is a free-form pass-through string: if Google has renamed the
# current Flash model, copy the exact id from AI Studio — no code change needed.
# Free-tier terms: Google may use submitted content to improve its products and
# human reviewers may read it — send SYNTHETIC TEST DATA ONLY, never sensitive
# financial documents or personal information, on the free tier.
# Optional OpenAI-compatible Responses API endpoint:
# OPENAI_BASE_URL=

# Approved model lanes (Joseph, 2026-11-04 — status record: docs/integrations.md).
# Each lane is selected the same way: MODEL=<lane>/<model-id> plus the lane key.
# MODEL=groq/openai/gpt-oss-120b
# GROQ_API_KEY=  # Groq free tier — LIVE, verified 2026-11-04.
# MODEL=venice/<model-id>
# VENICE_API_KEY=  # Venice — CONFIGURED BUT UNVERIFIED: the model list reads
# fine, but chat completions returned 401 from Venice's side on 2026-11-04.
# Do not treat this lane as working until a fresh key passes a chat test.
# ATLAS lane: ENABLED by the owner's orders 2026-11-04 ("Turn ATLAS
# on" + the free-route clarification: "the free part of Atlas").
# Powered by the FREE route: GPT-OSS 120B via the Groq free tier
# (Groq's OpenAI-compatible endpoint). This is NOT a paid OpenAI API
# connection — no OPENAI_API_KEY exists for this lane and none will be
# funded. To run a model task on the ATLAS route, select it with:
# MODEL=openai/openai/gpt-oss-120b
# (the runtime strips the first "openai/" as the provider name and sends
# the rest as the model id — Groq's literal id for this model is
# "openai/gpt-oss-120b", verified 2026-11-04: the single-prefix form is
# rejected by Groq as an unknown model)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=<the Groq key — Groq accepts it on its compatible endpoint>
# Billing: free_then_paid with auto cut-off — if the Groq free route
# ever stops being free, the lane cuts off; it never charges.
# ATLAS_LANE_ENABLED=false turns the lane off.

# Approved external lanes (self-hosted services; unset = lane off).
# /api/health reports which of these are configured. See docs/integrations.md.
# OMNIROUTE_URL=http://127.0.0.1:8765  # free model router (Groq + Gemini lanes)
# MEM0_URL=http://127.0.0.1:8888       # MAIN memory lane (owner's decision 2026-11-04)
# GRAPHITI_URL=http://127.0.0.1:8000   # SIDE memory lane — temporal graph, retires superseded facts (runs alongside Mem0)
# HINDSIGHT_URL=http://127.0.0.1:8931  # THIRD memory lane — verbatim facts + correction ranking (heavy footprint; runs beside Mem0 + Graphiti)
# N8N_URL=http://127.0.0.1:5678        # workflow automation (localhost only)
# ANYTHINGLLM_URL=http://127.0.0.1:3001  # workspace / RAG surface

# Live Google workspace: WORKSPACE_MODE=live, AGENT_BACKEND=model.
# OPENMUSE_ACCESS_KEY=  # random secret, at least 24 characters
# TOKEN_ENCRYPTION_KEY=  # 32 random bytes encoded as base64
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OAuth callback is PUBLIC_API_URL + /api/google/callback

# Optional separate task worker; all processes share DATA_DIR for PDF files.
# DATABASE_URL=postgresql://...
# Set TASK_WORKER_ENABLED=false on the API when using pnpm dev:worker.

# Browser worker (separate from the task worker):
# BROWSER_WORKER_URL=http://127.0.0.1:8790
# WORKER_TOKEN=  # same random 32+ character secret in API and browser worker
WORKER_DATA_DIR=.openmuse/browser-profiles
WORKER_HOST=127.0.0.1

# An optional external raw AG-UI agent replaces conversational routing only.
# AGENT_BACKEND=agui
# AGENT_URL=https://your-agent.example/run
# AGENT_TOKEN=
# OpenBot's Intelligence runtime is not this raw AG-UI URL. See its adapter docs.

# Optional CopilotKit Rich Threads. Server-only project key; enables managed
# conversation persistence, native thread switching and event replay.
# Leave unset for the open-source local conversation store.
CPK_INTELLIGENCE_API_KEY=

# Optional private Docker Linux computer (separate from the browser).
# Build first: docker build -t openmuse-computer:local apps/computer
# Docker must be reachable from the API and any separate task worker.
COMPUTER_ENABLED=false
COMPUTER_IMAGE=openmuse-computer:local
# Stable deployment name shared by API and worker; defaults to a hash of PUBLIC_API_URL.
# COMPUTER_DEPLOYMENT_ID=my-openmuse
# Optional scoped Docker engine, e.g. DOCKER_CONTEXT=colima-openmuse
